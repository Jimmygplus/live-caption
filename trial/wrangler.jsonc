{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "live-caption-trial-broker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "vars": {
    "ALLOWED_ORIGINS": "https://jimmygplus.github.io,http://localhost:5175,http://127.0.0.1:5175",
    // Ceiling on trials handed out per day. At roughly 0.12 AUD per streamed
    // hour a trial costs about 0.06 AUD, so this caps a runaway day near 1.2 AUD.
    "TRIAL_DAILY_LIMIT": "20",
    // Per-address ceiling per day, so one visitor cannot drain the allowance
    // above. Shared by everyone behind the same NAT, hence not 1.
    "TRIAL_DAILY_PER_ADDRESS": "3"
  },
  "d1_databases": [
    {
      "binding": "TRIAL_DB",
      "database_name": "live-caption-trials",
      "database_id": "89d27457-9685-4a71-9f33-1db827a6dbca",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
