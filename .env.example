# Copy this file to .env and fill in what you have.
#   cp .env.example .env
# 改完必须重启 node server.js —— .env 只在启动时读一次。

# ---------------------------------------------------------------- 字幕（ASR）

# 必填。https://console.soniox.com 注册后创建 API Key。
# 实时转写 ~US$0.12/小时。长期 key 只留在服务器，浏览器只拿 60 秒临时 key。
SONIOX_API_KEY=

# ---------------------------------------------------------------- 翻译

# 腾讯云机器翻译（TMT）。每月 500 万字符免费，超出 ¥58/百万字符。
# 控制台 → 访问管理 → API 密钥管理 创建 SecretId / SecretKey，
# 并在「机器翻译」产品页开通服务。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 可选，默认 ap-guangzhou
# TENCENT_REGION=ap-guangzhou
# 可选，默认 0
# TENCENT_PROJECT_ID=0

# Claude Haiku 翻译（备选）。$1/$5 每百万 token。
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- 其他

# 可选：改本地端口，默认 5175
# PORT=5175

# 混元翻译可选调参（默认已是较好的组合）
# hunyuan-translation（默认，质量更好）或 hunyuan-translation-lite（约便宜 4 倍）
# HUNYUAN_TRANSLATE_MODEL=hunyuan-translation
# 领域提示，影响用词风格
# HUNYUAN_TRANSLATE_FIELD=商务会议对话
# 术语库 ID（控制台创建，逗号分隔，最多 5 个）。治行业黑话必备。
# HUNYUAN_GLOSSARY_IDS=xxxxxxxx,yyyyyyyy
